# Obsidian per-machine state, not worth versioning
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/recent-files-obsidian/data.json
.obsidian/plugins/omnisearch/data.json
.obsidian/plugins/obsidian-excalidraw-plugin/data.json

# Termy: per-machine binary and live editor state, redownloaded on install
.obsidian/plugins/termy/binaries/
.obsidian/plugins/termy/agent-context/

# Session handoff scratch files (/handoff command), not vault content
.claude/handoff-pending.md
.claude/handoff-archive/

# Third-party Obsidian plugin bundles (~11 MB). community-plugins.json lists them; Obsidian reinstalls on open.
.obsidian/plugins/

# Termy-managed Codex skill, regenerated by the plugin
.agents/
